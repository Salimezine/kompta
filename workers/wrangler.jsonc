{
  "name": "comptaflow-api",
  "main": "src/index.js",
  "compatibility_date": "2024-05-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comptaflow-db",
      "database_id": "local-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "comptaflow-documents"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "local-cache"
    }
  ]
}
